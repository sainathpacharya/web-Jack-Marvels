# --- Production (`vite build` / deploy) ---
# Baked in at build time. `scripts/deploy-ec2.sh` defaults to https://api.alphavlogs.com.
# For local production build: copy to `.env.production` (gitignored) or run:
#   VITE_API_BASE_URL=https://api.alphavlogs.com npm run build
# VITE_API_BASE_URL=https://api.alphavlogs.com

# --- Local dev (`vite`) ---
# Default API origin is http://localhost:8080 (browser → Spring; enable CORS for http://localhost:5173).
# VITE_DEV_API_BASE_URL=http://127.0.0.1:8081

# Use same-origin /api + Vite proxy instead (no CORS to 8080). See vite.config.js.
# VITE_DEV_USE_VITE_PROXY=true

# When using the proxy, where Vite forwards /api (default http://localhost:8080).
# VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# Log every API call (server + full endpoint) in the browser console. On by default in `vite`;
# set to true in production build only when debugging (noisy).
# VITE_LOG_API=true

